<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:gravity="center"
    android:orientation="vertical"
    tools:context=".RevealAnswerActivity">

    <TextView
        android:id="@+id/answer_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="32dp"
        android:gravity="center"
        android:textSize="24sp"
        tools:text="This is the revealed answer" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        android:text="Who got it right?" />

    <Button
        android:id="@+id/team_a_correct_button"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Team A" />

    <Button
        android:id="@+id/team_b_correct_button"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Team B" />

    <Button
        android:id="@+id/none_correct_button"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Neither" />

</LinearLayout>